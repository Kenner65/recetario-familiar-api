# Variables de entorno de la API. NUNCA subir este archivo ni sus valores a Git.
# En Vercel se configuran desde el panel del proyecto (Settings → Environment Variables).
# Copia este archivo a `.env.local` para desarrollo local.

# --- Firebase Admin (cuenta de servicio) ---
# ID del proyecto Firebase.
FIREBASE_PROJECT_ID=
# Correo de la cuenta de servicio (Firebase → Configuración → Cuentas de servicio).
FIREBASE_CLIENT_EMAIL=
# Clave privada de la cuenta de servicio. En Vercel pégala con \n literales;
# la API los convierte a saltos de línea al iniciar.
FIREBASE_PRIVATE_KEY=

# --- Firebase Web API Key (para la API REST de Auth) ---
FIREBASE_WEB_API_KEY=

# --- Vercel Blob ---
# Se obtiene con `vercel blob create-store` y `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
